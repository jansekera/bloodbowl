-enum ExtraFeature : unsigned { kP213EscapeFirst = 1, kP213EscapeRolls = 2, kP216ReadyAnyway = 4 };
+//   P217 (uživatel 19.10.: „dokud je bezpečná klec — nic jiného“): bezpečná klec s rezervou neskóruje
+//   přes hod (5) · zdržování bankuje k zóně (1) · nejvyšší šance na TD s nejhorší odpovědí soupeře (3).
+enum ExtraFeature : unsigned {
+    kP213EscapeFirst = 1, kP213EscapeRolls = 2, kP216ReadyAnyway = 4,
+    kP217SafeCageWaits = 8, kP217StallBanks = 16, kP217BestChance = 32
