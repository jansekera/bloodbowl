diff --git a/engine/tests/test_one_cage.cpp b/engine/tests/test_one_cage.cpp
index 7501557d..b4b46d3c 100644
--- a/engine/tests/test_one_cage.cpp
+++ b/engine/tests/test_one_cage.cpp
@@ -1164,6 +1164,42 @@ TEST(OneCageStall, ThreatenedCarrierGoesForTheTouchdownThroughDiceACagedOneDoesN
     }
 }
 
+// P217 (5) (uživatel 19.10.: „dokud je bezpečná klec — nic jiného — pak útěk nebo TD, když klec nedojde
+// nebo není bezpečná“; situace 5 — bezpečná klec, TD přes hod s velkou šancí: „OK“). Nosič MA 6 sedm polí
+// před zónou: TD přes jedno GFI s týmovým přehozem (~0,97). Klec stojí, soupeř dosáhne jen slabou ranou
+// (hrozba pod 0,15, ale nad 1 − 0,97). Ve 3. kole má tým rezervu ⇒ klec jde dál a neskóruje; v 7. kole
+// rezervu nemá ⇒ skóruje se hned (jako dosud). Pojistka: s vypnutou úpravou skóruje i ve 3. kole.
+TEST(OneCageStall, ASafeCageWithTimeToSpareDoesNotScoreThroughDice) {
+    auto board = [](int turn) {
+        Board b(turn);
+        b.s.homeTeam.rerolls = 1;
+        b.put(1, TeamSide::HOME, {18, 7}, 6, 3, {SkillName::SureFeet});
+        b.put(2, TeamSide::HOME, {17, 6}); b.put(3, TeamSide::HOME, {17, 8});
+        b.put(4, TeamSide::HOME, {19, 6}); b.put(5, TeamSide::HOME, {19, 8});
+        b.put(13, TeamSide::AWAY, {static_cast<int8_t>(atoi(getenv("OX"))), static_cast<int8_t>(atoi(getenv("OY")))}, 6);
+        b.s.ball = BallState::carried({18, 7}, 1);
+        return b;
+    };
+    auto scored = [&](int turn) {
+        Board b = board(turn);
+        CageController cc(nullptr, cfg(), 1);
+        std::vector<Macro> ms;
+        playAll(cc, b, &ms);
+        return std::any_of(ms.begin(), ms.end(), [](const Macro& m) { return m.type == MacroType::SCORE; });
+    };
+    {
+        Board b = board(3);
+        const double t = blitzThreat(b.s, b.s.getPlayer(1));
+        fprintf(stderr, "THREAT %.3f slack3 %d slack7 %d\n", t, teamHasTimeSlack(b.s, b.s.getPlayer(1)),
+                teamHasTimeSlack(board(7).s, board(7).s.getPlayer(1)));
+    }
+    EXPECT_FALSE(scored(3)) << "bezpečná klec s rezervou: TD přes hod se nehraje";
+    EXPECT_TRUE(scored(7)) << "bez rezervy: TD hned";
+    setExtraFeaturesOff(kP217SafeCageWaits);
+    EXPECT_TRUE(scored(3)) << "pozitivní kontrola: bez úpravy skóruje i ve 3. kole";
+    setExtraFeaturesOff(0);
+}
+
